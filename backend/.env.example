# ============================================
# AURELIA Backend - Environment Template
# Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored. NEVER commit real secrets.
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/aurelia

# --- Auth ---
# REQUIRED in every environment. The server throws at boot if
# NODE_ENV is not "development" and this is missing.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# NOTE: not yet read by the code. src/utils/jwt.js currently signs BOTH
# access and refresh tokens with JWT_SECRET. A dedicated secret for refresh
# tokens is tracked for Phase 5 (hardening) and requires a code change there.
JWT_REFRESH_SECRET=

# --- CORS ---
# NOTE: not yet read by the code. src/app.js currently calls cors() with no
# origin restriction, which allows any origin. Wiring CORS_ORIGIN to an
# allowlist is tracked for Phase 5 (hardening).
CORS_ORIGIN=http://localhost:3000

# --- Optional ---
# API_BASE_URL=http://localhost:5000/api/v1
# DEFAULT_TAX_RATE=0.08
